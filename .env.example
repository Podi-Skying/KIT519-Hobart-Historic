# Copy to .env.local (git-ignored) and fill in. For GitHub Pages, add the same
# values as repository secrets: GOOGLE_MAPS_API_KEY / GOOGLE_MAPS_MAP_ID.

# Google Maps JavaScript API browser key.
# Restrict it in Google Cloud Console › Credentials › Application restrictions › Websites:
#   http://localhost:5173/*
#   https://podi-skying.github.io/*
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Cloud-based map style (Map Management). Leave empty to use Google's demo map id.
VITE_GOOGLE_MAPS_MAP_ID=
